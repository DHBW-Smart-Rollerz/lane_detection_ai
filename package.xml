<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lane_detection_ai</name>
  <version>0.0.0</version>
  <description>AI lane detection based on Ultra Fast Lane Detection v2</description>
  <maintainer email="info@dhbw-smartrollerz.org">Smart Rollerz</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>camera_preprocessing</depend>
  <depend>lane_msgs</depend>
  <depend>timing</depend>
  <depend>setup_utils</depend>
  <depend>smarty_utils</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
